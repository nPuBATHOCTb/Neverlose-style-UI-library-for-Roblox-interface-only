	local function updateSliderFromX(x)
		local rel = math.clamp((x - popupBar.AbsolutePosition.X) / popupBar.AbsoluteSize.X, 0, 1)
		local val = math.floor(rel * sliderMax + 0.5)
		popupValue.Text = tostring(val)
		popupFill.Size = UDim2.new(rel, 0, 1, 0)
		popupKnob.Position = UDim2.new(rel, -4, 0.5, -4)
	end

	popupBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliderDragging = true
			updateSliderFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateSliderFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliderDragging = false
		end
	end)

