	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = btn

	local icon = Instance.new("TextLabel")
	icon.Text = iconText or "•"
	icon.Font = Enum.Font.GothamBold
	icon.TextSize = 12
	icon.TextColor3 = TEXT_DIM
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.new(0, 20, 1, 0)
	icon.Position = UDim2.new(0, 8, 0, 0)
	icon.TextXAlignment = Enum.TextXAlignment.Center
	icon.ZIndex = 5
	icon.Parent = btn

	local label = Instance.new("TextLabel")
	label.Text = name
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 12
	label.TextColor3 = TEXT_DIM
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -34, 1, 0)
	label.Position = UDim2.new(0, 30, 0, 0)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 5
	label.Parent = btn

	local page = Instance.new("Frame")
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.ZIndex = 4
	page.Parent = content

	local colLeft = Instance.new("ScrollingFrame")
	colLeft.Size = UDim2.new(0.5, -4, 1, 0)
	colLeft.Position = UDim2.new(0, 0, 0, 0)
	colLeft.BackgroundTransparency = 1
	colLeft.BorderSizePixel = 0
	colLeft.ScrollBarThickness = 3
	colLeft.ScrollBarImageColor3 = ACCENT
	colLeft.CanvasSize = UDim2.new(0, 0, 0, 0)
	colLeft.AutomaticCanvasSize = Enum.AutomaticSize.Y
	colLeft.ScrollingDirection = Enum.ScrollingDirection.Y
	colLeft.ZIndex = 4
	colLeft.Parent = page

	local colLeftLayout = Instance.new("UIListLayout")
	colLeftLayout.Padding = UDim.new(0, 6)
	colLeftLayout.SortOrder = Enum.SortOrder.LayoutOrder
	colLeftLayout.Parent = colLeft

	local colLeftPad = Instance.new("UIPadding")
	colLeftPad.PaddingBottom = UDim.new(0, 12)
	colLeftPad.PaddingRight = UDim.new(0, 6)
	colLeftPad.Parent = colLeft

	local colRight = Instance.new("ScrollingFrame")
	colRight.Size = UDim2.new(0.5, -4, 1, 0)
	colRight.Position = UDim2.new(0.5, 4, 0, 0)
	colRight.BackgroundTransparency = 1
	colRight.BorderSizePixel = 0
	colRight.ScrollBarThickness = 3
	colRight.ScrollBarImageColor3 = ACCENT
	colRight.CanvasSize = UDim2.new(0, 0, 0, 0)
	colRight.AutomaticCanvasSize = Enum.AutomaticSize.Y
	colRight.ScrollingDirection = Enum.ScrollingDirection.Y
	colRight.ZIndex = 4
	colRight.Parent = page

	local colRightLayout = Instance.new("UIListLayout")
	colRightLayout.Padding = UDim.new(0, 6)
	colRightLayout.SortOrder = Enum.SortOrder.LayoutOrder
	colRightLayout.Parent = colRight

	local colRightPad = Instance.new("UIPadding")
	colRightPad.PaddingBottom = UDim.new(0, 12)
	colRightPad.PaddingRight = UDim.new(0, 6)
	colRightPad.Parent = colRight

	local tab = {button = btn, label = label, icon = icon, page = page, left = colLeft, right = colRight}

	btn.MouseEnter:Connect(function()
		if activeTab ~= tab then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35, 35, 42), BackgroundTransparency = 0}):Play()
			TweenService:Create(label, TweenInfo.new(0.15), {TextColor3 = TEXT}):Play()
		end
	end)

	btn.MouseLeave:Connect(function()
		if activeTab ~= tab then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
			TweenService:Create(label, TweenInfo.new(0.15), {TextColor3 = TEXT_DIM}):Play()
		end
	end)

	btn.MouseButton1Click:Connect(function()
		closeAllPopups()
		if activeTab then
			activeTab.page.Visible = false
			TweenService:Create(activeTab.button, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
			TweenService:Create(activeTab.label, TweenInfo.new(0.15), {TextColor3 = TEXT_DIM}):Play()
			TweenService:Create(activeTab.icon, TweenInfo.new(0.15), {TextColor3 = TEXT_DIM}):Play()
		end
		activeTab = tab
		page.Visible = true
		TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = ACCENT_DIM, BackgroundTransparency = 0}):Play()
		TweenService:Create(label, TweenInfo.new(0.15), {TextColor3 = TEXT}):Play()
		TweenService:Create(icon, TweenInfo.new(0.15), {TextColor3 = ACCENT}):Play()
	end)

	Tabs[name] = tab
	return tab
end


local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
		closeAllPopups()
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)


