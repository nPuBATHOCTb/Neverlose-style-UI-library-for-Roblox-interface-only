	label.ZIndex = 5
	label.Parent = btn

	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(0, 2, 0, 0)
	accent.Position = UDim2.new(0, 0, 0.5, -9)
	accent.BackgroundColor3 = ACCENT
	accent.BorderSizePixel = 0
	accent.ZIndex = 5
	accent.Parent = btn

	local accentCorner = Instance.new("UICorner")
	accentCorner.CornerRadius = UDim.new(1, 0)
	accentCorner.Parent = accent

	local page = Instance.new("Frame")
	page.Size = UDim2.new(1, -16, 1, -16)
	page.Position = UDim2.new(0, 8, 0, 8)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.ZIndex = 4
	page.Parent = content

	local colLeft = Instance.new("Frame")
	colLeft.Size = UDim2.new(0.5, -4, 1, 0)
	colLeft.Position = UDim2.new(0, 0, 0, 0)
	colLeft.BackgroundTransparency = 1
	colLeft.ZIndex = 4
	colLeft.Parent = page

	local colLeftLayout = Instance.new("UIListLayout")
	colLeftLayout.Padding = UDim.new(0, 6)
	colLeftLayout.SortOrder = Enum.SortOrder.LayoutOrder
	colLeftLayout.Parent = colLeft

	local colRight = Instance.new("Frame")
	colRight.Size = UDim2.new(0.5, -4, 1, 0)
	colRight.Position = UDim2.new(0.5, 4, 0, 0)
	colRight.BackgroundTransparency = 1
	colRight.ZIndex = 4
	colRight.Parent = page

	local colRightLayout = Instance.new("UIListLayout")
	colRightLayout.Padding = UDim.new(0, 6)
	colRightLayout.SortOrder = Enum.SortOrder.LayoutOrder
	colRightLayout.Parent = colRight

	local tab = {button = btn, label = label, accent = accent, page = page, left = colLeft, right = colRight, icon = icon}

	btn.MouseEnter:Connect(function()
		if activeTab ~= tab then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 30, 38)}):Play()
		end
	end)

	btn.MouseLeave:Connect(function()
		if activeTab ~= tab then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = ELEMENT}):Play()
		end
	end)

	btn.MouseButton1Click:Connect(function()
		closeAllPopups()
		if activeTab then
			activeTab.page.Visible = false
			TweenService:Create(activeTab.button, TweenInfo.new(0.15), {BackgroundColor3 = ELEMENT}):Play()
			TweenService:Create(activeTab.label, TweenInfo.new(0.15), {TextColor3 = TEXT_DIM}):Play()
			TweenService:Create(activeTab.icon, TweenInfo.new(0.15), {ImageColor3 = TEXT_DIM}):Play()
			TweenService:Create(activeTab.accent, TweenInfo.new(0.15), {Size = UDim2.new(0, 2, 0, 0)}):Play()
		end
		activeTab = tab
		page.Visible = true
		TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = ACCENT_DIM}):Play()
		TweenService:Create(label, TweenInfo.new(0.15), {TextColor3 = TEXT}):Play()
		TweenService:Create(icon, TweenInfo.new(0.15), {ImageColor3 = ACCENT}):Play()
		TweenService:Create(accent, TweenInfo.new(0.2), {Size = UDim2.new(0, 2, 0, 18)}):Play()
	end)

	Tabs[name] = tab
	return tab
end

local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
		closeAllPopups()
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)
